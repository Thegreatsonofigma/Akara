NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SUPABASE_URL=https://jwjrktkhwovadtjhtltu.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key_keep_secret

AKARA_SEND_MODE=log
AKARA_ADMIN_TOKEN=replace_with_a_long_random_admin_token
AKARA_ADMIN_HOST=admin.tryakara.com
WHATSAPP_VERIFY_TOKEN=choose_a_private_random_phrase
WHATSAPP_ACCESS_TOKEN=replace_with_meta_system_user_token_keep_secret
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_meta_business_account_id
META_APP_SECRET=replace_with_meta_app_secret_keep_secret
AKARA_REQUIRE_WEBHOOK_SIGNATURE=true
AKARA_WHATSAPP_NUMBER=replace_with_whatsapp_number_digits_only
AKARA_PUBLIC_URL=https://api.tryakara.com
AKARA_SHARE_URL=https://api.tryakara.com

# Smart matching: briefly collect simultaneous listings, negotiate only close
# rate gaps, and avoid repeating a declined pairing during the cooldown.
AKARA_MATCHING_BATCH_WINDOW_MS=1200
AKARA_MATCHING_SWEEP_ENABLED=true
AKARA_MATCHING_SWEEP_INTERVAL_MS=30000
AKARA_MATCHING_SWEEP_BATCH_SIZE=100
AKARA_MATCHING_RESPONSE_REMINDER_MS=300000
AKARA_TRADE_PAYMENT_WINDOW_MS=1800000
AKARA_MATCHING_PAIR_COOLDOWN_MS=1800000
AKARA_NEGOTIATION_WINDOW_MS=600000
AKARA_NEGOTIATION_MAX_GAP_PERCENT=40

# Fincra partner rail. Keep disabled until sandbox credentials are configured.
# The read-only check never generates or executes a transaction.
AKARA_FINCRA_ENABLED=false
AKARA_FINCRA_ENVIRONMENT=sandbox
AKARA_FINCRA_API_KEY=replace_with_fincra_sandbox_secret_key_keep_secret
AKARA_FINCRA_PUBLIC_KEY=replace_with_fincra_sandbox_public_key
AKARA_FINCRA_BUSINESS_ID=replace_with_fincra_sandbox_business_id
AKARA_FINCRA_WEBHOOK_SECRET=replace_with_fincra_sandbox_webhook_secret_keep_secret
AKARA_FINCRA_TIMEOUT_MS=5000
# Only corridors confirmed for Akara's account. Do not add RWF until Fincra enables it.
AKARA_FINCRA_CORRIDORS=KES-NGN,GHS-NGN,XAF-NGN
# Must remain false until sandbox execution tests are deliberately approved.
AKARA_FINCRA_ALLOW_MUTATIONS=false
# Independent kill switches for each money-moving phase.
AKARA_FINCRA_ALLOW_COLLECTIONS=false
AKARA_FINCRA_ALLOW_PAYOUTS=false
# Must remain false in sandbox. Live requires explicit commercial/compliance approval.
AKARA_FINCRA_LIVE_ACK=false
# A second explicit acknowledgement is required before any live payout.
AKARA_FINCRA_LIVE_PAYOUT_ACK=false
AKARA_FINCRA_TEST_PAIR=KES-NGN

AKARA_ADMIN_PHONE=replace_with_your_whatsapp_number
AKARA_SECURITY_ENABLED=true
# Production-safe launch modes. Change either value to "flow" only after the
# corresponding Meta Flow has been successfully published.
AKARA_SECURITY_MODE=web
AKARA_SECURITY_FLOW_ID=replace_with_meta_whatsapp_flow_id
AKARA_VERIFICATION_MODE=manual
AKARA_VERIFICATION_FLOW_ID=replace_with_meta_whatsapp_verification_flow_id
# Use draft only while testing unpublished Flows. Remove it after publishing.
WHATSAPP_FLOW_MODE=draft

# Invisible Stellar integrity layer. Keep disabled until migration 008 is
# applied and a dedicated, low-balance Stellar account is configured.
AKARA_STELLAR_INTEGRITY_ENABLED=false
AKARA_STELLAR_NETWORK=testnet
# Must remain false on testnet. Set true only after the production privacy and
# key-management review has explicitly approved permanent public anchoring.
AKARA_STELLAR_MAINNET_ACK=false
AKARA_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
AKARA_STELLAR_SECRET_KEY=replace_with_dedicated_low_balance_stellar_secret
AKARA_STELLAR_PUBLIC_KEY=replace_with_matching_stellar_public_key
AKARA_STELLAR_MAX_FEE_STROOPS=10000
AKARA_STELLAR_BATCH_SIZE=64
AKARA_STELLAR_ANCHOR_INTERVAL_MS=60000
AKARA_INTEGRITY_HMAC_SECRET=replace_with_at_least_32_random_bytes_keep_secret

# Gemini (Google AI Studio) — free-tier NLP for out-of-scope messages
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5-nano

# Paystack — free NGN bank account resolution (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=replace_with_paystack_secret_key

# Website analytics and webmaster verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tryakara.com
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
