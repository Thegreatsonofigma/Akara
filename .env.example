# Invisible Stellar integrity layer. Keep disabled until migration 008 is
# applied and a dedicated, low-balance Stellar account is configured.
AKARA_STELLAR_INTEGRITY_ENABLED=false
AKARA_STELLAR_NETWORK=testnet
# Must remain false on testnet. Set true only after the production privacy and
# key-management review has explicitly approved permanent public anchoring.
AKARA_STELLAR_MAINNET_ACK=false
AKARA_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
AKARA_STELLAR_SECRET_KEY=replace_with_dedicated_low_balance_stellar_secret
AKARA_STELLAR_PUBLIC_KEY=replace_with_matching_stellar_public_key
AKARA_STELLAR_MAX_FEE_STROOPS=10000
AKARA_STELLAR_BATCH_SIZE=64
AKARA_STELLAR_ANCHOR_INTERVAL_MS=60000
AKARA_INTEGRITY_HMAC_SECRET=replace_with_at_least_32_random_bytes_keep_secret

# Gemini (Google AI Studio) — free-tier NLP for out-of-scope messages
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5-nano

# Paystack — free NGN bank account resolution (https://dashboard.paystack.com/#/settings/developers)
