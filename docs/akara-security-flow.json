{
  "version": "7.3",
  "screens": [
    {
      "id": "SECURITY_PIN",
      "title": "Security Check",
      "terminal": true,
      "success": true,
      "data": {
        "mode": {
          "type": "string",
          "__example__": "setup"
        },
        "challenge_token": {
          "type": "string",
          "__example__": "sample-token"
        },
        "action_label": {
          "type": "string",
          "__example__": "Edit payout detail"
        },
        "screen_heading": {
          "type": "string",
          "__example__": "Set up your passcode"
        },
        "screen_body": {
          "type": "string",
          "__example__": "Create a private 6 digit code for payout changes and other sensitive actions."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "security_pin_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.screen_heading}"
              },
              {
                "type": "TextBody",
                "text": "${data.screen_body}"
              },
              {
                "type": "TextBody",
                "text": "${data.action_label}"
              },
              {
                "type": "TextInput",
                "name": "passcode",
                "label": "Akara passcode",
                "input-type": "passcode",
                "required": true
              },
              {
                "type": "If",
                "condition": "${data.mode} == 'setup'",
                "then": [
                  {
                    "type": "TextInput",
                    "name": "confirm",
                    "label": "Confirm passcode",
                    "input-type": "passcode",
                    "required": true
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "mode": "${data.mode}",
                    "challenge_token": "${data.challenge_token}",
                    "action_label": "${data.action_label}",
                    "passcode": "${form.passcode}",
                    "confirm": "${form.confirm}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
