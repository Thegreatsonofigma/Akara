{
  "version": "7.3",
  "routing_model": {
    "KYC_DETAILS": ["KYC_REVIEW"],
    "KYC_REVIEW": []
  },
  "screens": [
    {
      "id": "KYC_DETAILS",
      "title": "Verify on Akara",
      "data": {
        "mode": {
          "type": "string",
          "__example__": "verification"
        },
        "verification_token": {
          "type": "string",
          "__example__": "sample-token"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "verification_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Verify your Akara profile"
              },
              {
                "type": "TextBody",
                "text": "Add the details exactly as they appear on your ID. You will upload your ID and selfie in chat after this."
              },
              {
                "type": "TextInput",
                "name": "legal_name",
                "label": "Full legal name",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "name": "nationality",
                "label": "Nationality",
                "required": true,
                "data-source": [
                  { "id": "NG", "title": "Nigeria" },
                  { "id": "RW", "title": "Rwanda" },
                  { "id": "GH", "title": "Ghana" },
                  { "id": "KE", "title": "Kenya" },
                  { "id": "CM", "title": "Cameroon" },
                  { "id": "GA", "title": "Gabon" },
                  { "id": "OTHER", "title": "Other" }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "residence_country",
                "label": "Country of residence",
                "required": true,
                "data-source": [
                  { "id": "RW", "title": "Rwanda" },
                  { "id": "NG", "title": "Nigeria" },
                  { "id": "GH", "title": "Ghana" },
                  { "id": "KE", "title": "Kenya" },
                  { "id": "CM", "title": "Cameroon" },
                  { "id": "GA", "title": "Gabon" },
                  { "id": "OTHER", "title": "Other" }
                ]
              },
              {
                "type": "TextInput",
                "name": "city",
                "label": "City",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "name": "id_type",
                "label": "ID type",
                "required": true,
                "data-source": [
                  { "id": "passport", "title": "Passport" },
                  { "id": "national_id", "title": "National ID" },
                  { "id": "residence_permit", "title": "Residence permit" },
                  { "id": "student_id", "title": "Student ID" }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "id_country",
                "label": "ID issuing country",
                "required": true,
                "data-source": [
                  { "id": "NG", "title": "Nigeria" },
                  { "id": "RW", "title": "Rwanda" },
                  { "id": "GH", "title": "Ghana" },
                  { "id": "KE", "title": "Kenya" },
                  { "id": "CM", "title": "Cameroon" },
                  { "id": "GA", "title": "Gabon" },
                  { "id": "OTHER", "title": "Other" }
                ]
              },
              {
                "type": "TextInput",
                "name": "id_number",
                "label": "ID number",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Review details",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "KYC_REVIEW"
                  },
                  "payload": {
                    "legal_name": "${form.legal_name}",
                    "nationality": "${form.nationality}",
                    "residence_country": "${form.residence_country}",
                    "city": "${form.city}",
                    "id_type": "${form.id_type}",
                    "id_country": "${form.id_country}",
                    "id_number": "${form.id_number}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "KYC_REVIEW",
      "title": "Review Your Details",
      "terminal": true,
      "success": true,
      "data": {
        "legal_name": {
          "type": "string",
          "__example__": "Promise Uchenna Steven"
        },
        "nationality": {
          "type": "string",
          "__example__": "NG"
        },
        "residence_country": {
          "type": "string",
          "__example__": "RW"
        },
        "city": {
          "type": "string",
          "__example__": "Kigali"
        },
        "id_type": {
          "type": "string",
          "__example__": "passport"
        },
        "id_country": {
          "type": "string",
          "__example__": "NG"
        },
        "id_number": {
          "type": "string",
          "__example__": "A12345678"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Check before submitting"
          },
          {
            "type": "TextBody",
            "text": "Name: ${data.legal_name}\nNationality: ${data.nationality}\nResidence: ${data.residence_country}\nCity: ${data.city}\nID: ${data.id_type}\nIssued by: ${data.id_country}\nID number: ${data.id_number}"
          },
          {
            "type": "TextBody",
            "text": "Use the back arrow to correct anything. Submit only when these details match your identification document."
          },
          {
            "type": "Footer",
            "label": "Submit verification",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "mode": "verification",
                "legal_name": "${data.legal_name}",
                "nationality": "${data.nationality}",
                "residence_country": "${data.residence_country}",
                "city": "${data.city}",
                "id_type": "${data.id_type}",
                "id_country": "${data.id_country}",
                "id_number": "${data.id_number}"
              }
            }
          }
        ]
      }
    }
  ]
}
